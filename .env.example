# Database (MySQL 8)
DATABASE_URL="mysql://root:admin@localhost:3306/verbatim"

# LLM Provider (Gemini via OpenAI-compatible endpoint)
LLM_API_KEY=""
LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
LLM_MODEL="gemini-2.5-flash"
LLM_MAX_CONCURRENCY="2"
LLM_REASONING_EFFORT=""

# Ingestion & limits
MAX_UPLOAD_MB="25"
CHUNK_TOKENS="24000"
MAX_DOCS_PER_QUESTION="5"

# LibreOffice binary path (soffice on PATH or explicit path)
SOFFICE_PATH="soffice"

# Redline author metadata
REDLINE_AUTHOR="Verbatim AI"
