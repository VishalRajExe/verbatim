generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model comparison {
  id               String             @id
  docAId           String
  docBId           String
  status           String
  stage            String?
  summary          String?            @db.LongText
  stats            Json?
  errorMessage     String?
  createdAt        DateTime           @default(now())
  comparisonchange comparisonchange[]
}

model comparisonchange {
  id            String     @id
  comparisonId  String
  orderIdx      Int
  type          String
  significance  String
  category      String?
  title         String
  summary       String     @db.Text
  summarySource String
  aText         String?    @db.Text
  bText         String?    @db.Text
  aStart        Int?
  aEnd          Int?
  bStart        Int?
  bEnd          Int?
  comparison    comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade, map: "ComparisonChange_comparisonId_fkey")

  @@index([comparisonId], map: "ComparisonChange_comparisonId_idx")
}

model conversation {
  id                   String                 @id
  title                String
  kind                 String
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  conversationdocument conversationdocument[]
  message              message[]
}

model conversationdocument {
  conversationId String
  documentId     String
  conversation   conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, map: "ConversationDocument_conversationId_fkey")
  document       document     @relation(fields: [documentId], references: [id], onDelete: Cascade, map: "ConversationDocument_documentId_fkey")

  @@id([conversationId, documentId])
  @@index([documentId], map: "ConversationDocument_documentId_fkey")
}

model document {
  id                   String                 @id
  name                 String
  kind                 String
  sizeBytes            Int
  sha256               String?
  status               document_status        @default(QUEUED)
  stage                String?
  progress             Int                    @default(0)
  pageCount            Int?
  charCount            Int?
  tokenEstimate        Int?
  errorCode            String?
  errorMessage         String?
  warnings             Json?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  conversationdocument conversationdocument[]
  documentfile         documentfile?
  documentpage         documentpage[]
  documenttext         documenttext?
  quote                quote[]

  @@index([status], map: "Document_status_idx")
}

model documentfile {
  documentId String   @id
  original   Bytes
  rendition  Bytes?
  document   document @relation(fields: [documentId], references: [id], onDelete: Cascade, map: "DocumentFile_documentId_fkey")
}

model documentpage {
  documentId String
  pageNo     Int
  charStart  Int
  charEnd    Int
  width      Float
  height     Float
  items      Json
  document   document @relation(fields: [documentId], references: [id], onDelete: Cascade, map: "DocumentPage_documentId_fkey")

  @@id([documentId, pageNo])
}

model documenttext {
  documentId String   @id
  text       String   @db.LongText
  document   document @relation(fields: [documentId], references: [id], onDelete: Cascade, map: "DocumentText_documentId_fkey")
}

model message {
  id             String         @id
  conversationId String
  role           String
  content        String         @db.LongText
  status         message_status @default(COMPLETE)
  coverage       Json?
  errorMessage   String?
  createdAt      DateTime       @default(now())
  conversation   conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade, map: "Message_conversationId_fkey")
  quote          quote[]

  @@index([conversationId], map: "Message_conversationId_idx")
}

model quote {
  id         String   @id
  messageId  String
  documentId String
  ref        String
  text       String   @db.Text
  verified   Boolean
  matchKind  String?
  failReason String?
  ranges     Json?
  document   document @relation(fields: [documentId], references: [id], onDelete: Cascade, map: "Quote_documentId_fkey")
  message    message  @relation(fields: [messageId], references: [id], onDelete: Cascade, map: "Quote_messageId_fkey")

  @@index([documentId], map: "Quote_documentId_idx")
  @@index([messageId], map: "Quote_messageId_idx")
}

model redline {
  id          String   @id
  documentId  String
  instruction String   @db.Text
  edits       Json
  status      String
  output      Bytes?
  createdAt   DateTime @default(now())

  @@index([documentId], map: "Redline_documentId_idx")
}

enum message_status {
  STREAMING
  COMPLETE
  STOPPED
  ERROR
}

enum document_status {
  QUEUED
  EXTRACTING
  CONVERTING
  INDEXING
  READY
  FAILED
}
